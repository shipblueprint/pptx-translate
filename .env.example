# Translation provider: deepl | deeplx | gtx | edge | google | googlecloud | azure | amazon | qwen_dashscope | libretranslate | openai_compatible
TRANSLATOR_PROVIDER=deepl

# Target language (e.g., ZH, ZH-CN, JA, KO, ES, FR, DE)
TARGET_LANG=ZH

# Input/output files
INPUT_PPTX=Pitch-Deck.pptx
OUTPUT_PPTX=Pitch-Deck_translated.pptx

# API keys
DEEPL_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LIBRETRANSLATE_URL=http://localhost:5000/translate
DEEPLX_URL=http://localhost:1188/translate
GTX_URL=
EDGE_URL=

# Fallback chain (comma-separated). If empty, uses TRANSLATOR_PROVIDER or defaults.
TRANSLATOR_CHAIN=deeplx,gtx,libretranslate
QUOTA_WARN_CHARS=400000

# Edge API
EDGE_URL=https://api-edge.cognitive.microsofttranslator.com/translate
